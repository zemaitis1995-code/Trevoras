<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F3F6F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="28dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TREVORAS"
                    android:textColor="#111820"
                    android:textSize="29sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="— ANTANAS EDITION —"
                    android:textColor="#5D6B78"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● TFT"
                android:textColor="#1D8A4A"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- BIKE HERO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_white"
            android:padding="12dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="185dp"
                android:src="@drawable/trevoras_bike"
                android:scaleType="centerInside"
                android:contentDescription="Trevoras motociklas"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DABAR"
                        android:textColor="#8A949D"
                        android:textSize="11sp"
                        android:textStyle="bold"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/speed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#111820"
                            android:textSize="54sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingLeft="7dp"
                            android:paddingBottom="9dp"
                            android:text="km/h"
                            android:textColor="#5D6B78"
                            android:textSize="14sp"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:id="@+id/trip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kelionė  0.0 km"
                        android:textColor="#25313C"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/maxspeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="3dp"
                        android:text="Max  0 km/h"
                        android:textColor="#25313C"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="3dp"
                        android:text="Laikas  00:00"
                        android:textColor="#25313C"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="3dp"
                        android:text="Kryptis  —"
                        android:textColor="#25313C"
                        android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/startTrip"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="2"
                    android:text="PRADĖTI VAŽIAVIMĄ"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/button_red"/>

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp"/>

                <Button
                    android:id="@+id/resetTrip"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="RESET"
                    android:textColor="#25313C"
                    android:background="@drawable/button_light"/>
            </LinearLayout>
        </LinearLayout>

        <!-- MAP -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="Žemėlapis"
            android:textColor="#111820"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_white"
            android:padding="12dp">

            <WebView
                android:id="@+id/mapWeb"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:background="#DDE7ED"/>

            <EditText
                android:id="@+id/destination"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/input_bg"
                android:hint="Kur važiuojam?"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:singleLine="true"
                android:textColor="#111820"
                android:textColorHint="#9AA5AE"
                android:textSize="15sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/googleMaps"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="GOOGLE MAPS"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/button_red"/>

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp"/>

                <Button
                    android:id="@+id/waze"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="WAZE"
                    android:textColor="#25313C"
                    android:background="@drawable/button_light"/>
            </LinearLayout>
        </LinearLayout>

        <!-- MUSIC -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="Muzika"
            android:textColor="#111820"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_white"
            android:padding="14dp">

            <TextView
                android:id="@+id/track"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Spotify / medija"
                android:textColor="#111820"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="—"
                android:textColor="#7A8792"
                android:textSize="14sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/prev"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="◀◀"
                    android:background="@drawable/button_light"/>

                <Space android:layout_width="8dp" android:layout_height="1dp"/>

                <Button
                    android:id="@+id/play"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="▶ / ❚❚"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/button_red"/>

                <Space android:layout_width="8dp" android:layout_height="1dp"/>

                <Button
                    android:id="@+id/next"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="▶▶"
                    android:background="@drawable/button_light"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/openSpotify"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="ATIDARYTI SPOTIFY"
                    android:background="@drawable/button_light"/>

                <Space android:layout_width="8dp" android:layout_height="1dp"/>

                <Button
                    android:id="@+id/mediaPermission"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="MUZIKOS LEIDIMAS"
                    android:background="@drawable/button_light"/>
            </LinearLayout>
        </LinearLayout>

        <!-- BIKE INFO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="Trevoras"
            android:textColor="#111820"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/bikeInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_white"
            android:padding="14dp"
            android:text="RPM  —     Pavara  —     Temp.  —\nKuras  —     ABS  —"
            android:textColor="#25313C"
            android:textSize="14sp"/>

        <!-- TFT DIAGNOSTICS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="TFT / Diagnostika"
            android:textColor="#111820"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_white"
            android:padding="14dp">

            <TextView
                android:id="@+id/castStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TFT: pasiruošęs"
                android:textColor="#25313C"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/castIp"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="2"
                    android:background="@drawable/input_bg"
                    android:hint="TFT IP"
                    android:inputType="text"
                    android:paddingLeft="12dp"
                    android:singleLine="true"
                    android:text="192.168.43.2"/>

                <Space android:layout_width="8dp" android:layout_height="1dp"/>

                <EditText
                    android:id="@+id/castPort"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_bg"
                    android:hint="Portas"
                    android:inputType="number"
                    android:paddingLeft="12dp"
                    android:singleLine="true"
                    android:text="8888"/>
            </LinearLayout>

            <Button
                android:id="@+id/autoDiscover"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:text="AUTO RASTI TFT"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_red"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/testTft"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="TFT TESTAS"
                    android:background="@drawable/button_light"/>

                <Space android:layout_width="8dp" android:layout_height="1dp"/>

                <Button
                    android:id="@+id/deepScan"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="GILUS SKENAVIMAS"
                    android:background="@drawable/button_light"/>
            </LinearLayout>

            <TextView
                android:id="@+id/discoveryLog"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/diag_bg"
                android:padding="10dp"
                android:text="Diagnostikos žurnalas"
                android:textColor="#596773"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/copyDiag"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:text="KOPIJUOTI DIAGNOSTIKĄ"
                android:background="@drawable/button_light"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/startCast"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="START TFT"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/button_red"/>

                <Space android:layout_width="8dp" android:layout_height="1dp"/>

                <Button
                    android:id="@+id/stopCast"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="STOP"
                    android:background="@drawable/button_light"/>
            </LinearLayout>
        </LinearLayout>

        <!-- VISUAL BOTTOM NAV -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_white"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="6dp"
            android:paddingRight="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⌂\nPradžia"
                android:textColor="#D71920"
                android:textSize="11sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⌖\nŽemėlapis"
                android:textColor="#6F7B85"
                android:textSize="11sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🏍\nRide"
                android:textColor="#6F7B85"
                android:textSize="11sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="♫\nMuzika"
                android:textColor="#6F7B85"
                android:textSize="11sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⚙\nTrevoras"
                android:textColor="#6F7B85"
                android:textSize="11sp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
