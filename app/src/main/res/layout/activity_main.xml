<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F8FB">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="78dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="18dp"
    android:paddingRight="18dp">

    <!-- NUSTATYMAI -->
    <TextView
        android:id="@+id/settingsButton"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:gravity="center"
        android:text="⚙"
        android:textSize="26sp"
        android:textColor="#263640"
        android:background="@drawable/chip_white"/>

    <!-- LOGOTIPAS -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TREVORAS"
            android:textColor="#14202B"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"/>

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="— ANTANAS EDITION —"
            android:textColor="#8794A0"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"/>
    </LinearLayout>

    <!-- TFT BŪSENA -->
    <LinearLayout
        android:layout_width="98dp"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/tft_badge_bg">

        <TextView
            android:id="@+id/tftDot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="#9AA6AF"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tftBadgeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:text="TFT&#10;NEPRIJUNGTAS"
            android:gravity="center"
            android:textColor="#293640"
            android:textSize="8sp"
            android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>

<!-- HERO -->
<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="330dp">

    <!-- PAJŪRIO FONAS -->
    <ImageView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:src="@drawable/trevoras_hero"
    android:scaleType="centerCrop"
    android:contentDescription="Trevoras"/>

    <!-- LIVE ORAS -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="18dp"
        android:orientation="vertical"
        android:padding="9dp"
        android:background="@drawable/chip_white">

        <TextView
            android:id="@+id/weatherTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☀  —°C"
            android:textColor="#18242E"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/weatherCity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nustatoma vieta..."
            android:textColor="#53616D"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/weatherDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Orų duomenys"
            android:textColor="#7E8C98"
            android:textSize="10sp"/>

    </LinearLayout>

    <!-- LIVE DATA IR LAIKAS -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginRight="22dp"
        android:layout_marginTop="18dp"
        android:orientation="vertical"
        android:gravity="end"
        android:padding="9dp"
        android:background="@drawable/chip_white">

        <TextView
            android:id="@+id/heroDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="---- -- --"
            android:textColor="#53616D"
            android:textSize="10sp"/>

        <TextView
            android:id="@+id/heroClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textColor="#18242E"
            android:textSize="18sp"
            android:textStyle="bold"/>

    </LinearLayout>

</FrameLayout>
            <!-- STATS -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="92dp"
    android:layout_marginLeft="18dp"
    android:layout_marginRight="18dp"
    android:layout_marginTop="-12dp"
    android:orientation="horizontal"
    android:gravity="center"
    android:elevation="6dp"
    android:background="@drawable/card_white_rounded">

    <!-- KELIONĖ -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_trip"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="7dp"
                android:text="Kelionė"
                android:textColor="#788691"
                android:textSize="11sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/trip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="0.0 km"
            android:textColor="#14222D"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="52dp"
        android:background="#E5EBF0"/>

    <!-- LAIKAS -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_time"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="7dp"
                android:text="Laikas"
                android:textColor="#788691"
                android:textSize="11sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="00:00"
            android:textColor="#14222D"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="52dp"
        android:background="#E5EBF0"/>

    <!-- MAX GREITIS -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_speed"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="7dp"
                android:text="MAX greitis"
                android:textColor="#788691"
                android:textSize="10sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/maxspeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="0 km/h"
            android:textColor="#14222D"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="52dp"
        android:background="#E5EBF0"/>

    <!-- AUKŠTIS -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_altitude"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="7dp"
                android:text="Aukštis"
                android:textColor="#788691"
                android:textSize="11sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="— m"
            android:textColor="#14222D"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>
            <!-- MAP -->
            <TextView
    android:id="@+id/speed"
    android:layout_width="1dp"
    android:layout_height="1dp"
    android:visibility="gone"
    android:text="0"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="18dp"
                android:text="Žemėlapis"
                android:textColor="#17232D"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="245dp"
                android:layout_marginLeft="18dp"
                android:layout_marginRight="18dp"
                android:layout_marginTop="10dp"
                android:padding="8dp"
                android:elevation="3dp"
                android:background="@drawable/card_white_rounded">

                <WebView
                    android:id="@+id/mapWeb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#DDEEE6"/>

                <EditText
                    android:id="@+id/destination"
                    android:layout_width="170dp"
                    android:layout_height="48dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="10dp"
                    android:hint="📍 Palanga"
                    android:singleLine="true"
                    android:paddingLeft="14dp"
                    android:paddingRight="12dp"
                    android:textSize="12sp"
                    android:background="@drawable/chip_white"/>

                <Button
                    android:id="@+id/googleMaps"
                    android:layout_width="150dp"
                    android:layout_height="54dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="10dp"
                    android:text="➤ NAVIGUOTI"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/button_blue"/>

                <Button
                    android:id="@+id/waze"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="invisible"
                    android:text="Waze"/>
            </FrameLayout>

            <!-- MUSIC -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginLeft="18dp"
                android:layout_marginRight="18dp"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:elevation="3dp"
                android:background="@drawable/card_white_rounded">

                <ImageView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:src="@drawable/trevoras_bike"
                    android:scaleType="centerCrop"
                    android:contentDescription="Muzika"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/track"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Muzika"
                        android:textColor="#17232D"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Pasirinkite grojaraštį"
                        android:textColor="#8794A0"
                        android:textSize="12sp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/prev"
                    android:layout_width="42dp"
                    android:layout_height="48dp"
                    android:text="◀"
                    android:background="@android:color/transparent"/>

                <Button
                    android:id="@+id/play"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:text="▶"
                    android:textSize="18sp"
                    android:background="@drawable/play_circle"/>

                <Button
                    android:id="@+id/next"
                    android:layout_width="42dp"
                    android:layout_height="48dp"
                    android:text="▶"
                    android:background="@android:color/transparent"/>
            </LinearLayout>

            <!-- RIDE BUTTONS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:layout_marginRight="18dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/startTrip"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="PRADĖTI VAŽIAVIMĄ"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/button_blue"/>

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp"/>

                <Button
                    android:id="@+id/resetTrip"
                    android:layout_width="96dp"
                    android:layout_height="50dp"
                    android:text="RESET"
                    android:background="@drawable/chip_white"/>
            </LinearLayout>

            <!-- TFT / SYSTEM (kept but clean) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="18dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/card_white_rounded">

                <TextView
                    android:id="@+id/bikeInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RPM —   Pavara —   Temp. —   Kuras —   ABS —"
                    android:textColor="#6F7D88"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/castStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="TFT: pasiruošęs"
                    android:textColor="#25323C"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/castIp"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="2"
                        android:hint="TFT IP"
                        android:singleLine="true"
                        android:text="10.73.119.253"
                        android:paddingLeft="12dp"
                        android:background="@drawable/input_soft"/>

                    <Space android:layout_width="8dp" android:layout_height="1dp"/>

                    <EditText
                        android:id="@+id/castPort"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:hint="Portas"
                        android:singleLine="true"
                        android:inputType="number"
                        android:text="8888"
                        android:paddingLeft="12dp"
                        android:background="@drawable/input_soft"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/autoDiscover"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="AUTO TFT"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/button_blue"/>

                    <Space android:layout_width="6dp" android:layout_height="1dp"/>

                    <Button
                        android:id="@+id/testTft"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="TESTAS"
                        android:background="@drawable/chip_white"/>

                    <Space android:layout_width="6dp" android:layout_height="1dp"/>

                    <Button
                        android:id="@+id/deepScan"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="SKENUOTI"
                        android:background="@drawable/chip_white"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/discoveryLog"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="8dp"
                    android:padding="10dp"
                    android:text="Diagnostikos žurnalas"
                    android:textColor="#62717D"
                    android:textSize="11sp"
                    android:background="@drawable/input_soft"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/startCast"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="START TFT"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/button_blue"/>

                    <Space android:layout_width="6dp" android:layout_height="1dp"/>

                    <Button
                        android:id="@+id/stopCast"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="STOP"
                        android:background="@drawable/chip_white"/>
                </LinearLayout>

                <Button
                    android:id="@+id/copyDiag"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:text="KOPIJUOTI DIAGNOSTIKĄ"
                    android:background="@drawable/chip_white"/>

                <Button
                    android:id="@+id/openSpotify"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="invisible"
                    android:text="Spotify"/>

                <Button
                    android:id="@+id/mediaPermission"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="invisible"
                    android:text="Leidimas"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAV -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="◆\nPradžia"
            android:textColor="#2196F3"
            android:textSize="11sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌖\nŽemėlapis"
            android:textColor="#71818E"
            android:textSize="11sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🏍\nRide"
            android:textColor="#71818E"
            android:textSize="11sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♫\nMuzika"
            android:textColor="#71818E"
            android:textSize="11sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⚙\nTrevoras"
            android:textColor="#71818E"
            android:textSize="11sp"/>
    </LinearLayout>

</LinearLayout>
