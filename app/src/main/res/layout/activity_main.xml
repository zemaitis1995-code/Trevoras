<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F8FB">

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:background="#F4F8FB">

        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="☰"
            android:textSize="28sp"
            android:textColor="#1F2A33"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TREVORAS"
                android:textColor="#18232D"
                android:textSize="27sp"
                android:letterSpacing="0.08"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—  ANTANAS EDITION  —"
                android:textColor="#7C8995"
                android:textSize="9sp"
                android:letterSpacing="0.26"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="86dp"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/tft_badge_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textColor="#17C56B"
                android:textSize="14sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="TFT\nPRIJUNGTAS"
                android:gravity="center"
                android:textColor="#26313A"
                android:textSize="8sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginLeft="8dp"
            android:gravity="center"
            android:text="ᛒ"
            android:textSize="24sp"
            android:textColor="#2196F3"
            android:background="@drawable/circle_soft"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="18dp">

            <!-- HERO -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="348dp"
                android:background="@drawable/hero_sky_bg">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_gravity="top|start"
                    android:layout_marginLeft="24dp"
                    android:layout_marginTop="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="☀  18°C"
                        android:textColor="#24303A"
                        android:textSize="17sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Palanga"
                        android:textColor="#5F6C78"
                        android:textSize="12sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Giedra"
                        android:textColor="#8A98A4"
                        android:textSize="10sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end"
                    android:layout_gravity="top|end"
                    android:layout_marginRight="24dp"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ŠIANDIEN"
                        android:textColor="#697784"
                        android:textSize="9sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12:36"
                        android:textColor="#18232D"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="270dp"
                    android:layout_gravity="bottom"
                    android:layout_marginLeft="18dp"
                    android:layout_marginRight="18dp"
                    android:layout_marginBottom="2dp"
                    android:src="@drawable/trevoras_bike"
                    android:scaleType="centerInside"
                    android:contentDescription="Trevoras"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginRight="26dp"
                    android:layout_marginBottom="28dp"
                    android:text="Explore\nMore"
                    android:gravity="center"
                    android:textColor="#29343E"
                    android:textSize="16sp"
                    android:textStyle="italic"/>
            </FrameLayout>

            <!-- STATS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="-10dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:elevation="5dp"
                android:background="@drawable/card_round_white">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⌁  Kelionė"
                        android:textColor="#768490"
                        android:textSize="10sp"/>

                    <TextView
                        android:id="@+id/trip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0.0 km"
                        android:textColor="#17232D"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="46dp" android:background="#E3E9ED"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="◷  Laikas"
                        android:textColor="#768490"
                        android:textSize="10sp"/>

                    <TextView
                        android:id="@+id/time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="00:00"
                        android:textColor="#17232D"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="46dp" android:background="#E3E9ED"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="◴  MAX greitis"
                        android:textColor="#768490"
                        android:textSize="10sp"/>

                    <TextView
                        android:id="@+id/maxspeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0 km/h"
                        android:textColor="#17232D"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="46dp" android:background="#E3E9ED"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="△  Kryptis"
                        android:textColor="#768490"
                        android:textSize="10sp"/>

                    <TextView
                        android:id="@+id/heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="—"
                        android:textColor="#17232D"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- hidden speed value retained for MainActivity -->
            <TextView
                android:id="@+id/speed"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="invisible"
                android:text="0"/>

            <!-- MAP CARD -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="245dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="14dp"
                android:elevation="3dp"
                android:background="@drawable/card_round_white"
                android:padding="8dp">

                <WebView
                    android:id="@+id/mapWeb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#D8E9E1"/>

                <EditText
                    android:id="@+id/destination"
                    android:layout_width="145dp"
                    android:layout_height="48dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="10dp"
                    android:singleLine="true"
                    android:hint="📍  Palanga"
                    android:textSize="12sp"
                    android:textColor="#25313B"
                    android:textColorHint="#25313B"
                    android:paddingLeft="14dp"
                    android:paddingRight="12dp"
                    android:background="@drawable/chip_white"/>

                <Button
                    android:id="@+id/googleMaps"
                    android:layout_width="150dp"
                    android:layout_height="56dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="10dp"
                    android:text="➤  NAVIGUOTI"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/button_blue"/>

                <Button
                    android:id="@+id/waze"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="invisible"
                    android:text="WAZE"/>
            </FrameLayout>

            <!-- MUSIC CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:elevation="3dp"
                android:background="@drawable/card_round_white">

                <ImageView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:src="@drawable/trevoras_bike"
                    android:scaleType="centerCrop"
                    android:background="@drawable/music_cover_bg"
                    android:clipToOutline="true"
                    android:contentDescription="Muzika"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/track"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Muzika"
                        android:textColor="#17232D"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Pasirinkite grojaraštį"
                        android:textColor="#8A97A3"
                        android:textSize="12sp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="8dp"
                        android:background="#E4EAF0"/>
                </LinearLayout>

                <Button
                    android:id="@+id/prev"
                    android:layout_width="42dp"
                    android:layout_height="48dp"
                    android:text="◀"
                    android:textSize="18sp"
                    android:textColor="#17232D"
                    android:background="@android:color/transparent"/>

                <Button
                    android:id="@+id/play"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:text="▶"
                    android:textSize="20sp"
                    android:textColor="#17232D"
                    android:background="@drawable/play_circle"/>

                <Button
                    android:id="@+id/next"
                    android:layout_width="42dp"
                    android:layout_height="48dp"
                    android:text="▶"
                    android:textSize="18sp"
                    android:textColor="#17232D"
                    android:background="@android:color/transparent"/>
            </LinearLayout>

            <!-- RIDE CONTROLS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/startTrip"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="PRADĖTI VAŽIAVIMĄ"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/button_blue"/>

                <Space android:layout_width="8dp" android:layout_height="1dp"/>

                <Button
                    android:id="@+id/resetTrip"
                    android:layout_width="92dp"
                    android:layout_height="48dp"
                    android:text="RESET"
                    android:textColor="#34424E"
                    android:background="@drawable/chip_white"/>
            </LinearLayout>

            <!-- EXTRA / DIAGNOSTICS kept lower down so home stays clean -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/card_round_white">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trevoras / TFT"
                    android:textColor="#17232D"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/bikeInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="RPM —   Pavara —   Temp. —   Kuras —   ABS —"
                    android:textColor="#6D7A86"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/castStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="TFT: pasiruošęs"
                    android:textColor="#34424E"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/castIp"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="2"
                        android:hint="TFT IP"
                        android:singleLine="true"
                        android:paddingLeft="12dp"
                        android:text="10.73.119.253"
                        android:background="@drawable/input_soft"/>

                    <Space android:layout_width="8dp" android:layout_height="1dp"/>

                    <EditText
                        android:id="@+id/castPort"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:hint="Portas"
                        android:inputType="number"
                        android:singleLine="true"
                        android:paddingLeft="12dp"
                        android:text="8888"
                        android:background="@drawable/input_soft"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/autoDiscover"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="AUTO TFT"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/button_blue"/>

                    <Space android:layout_width="6dp" android:layout_height="1dp"/>

                    <Button
                        android:id="@+id/testTft"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="TESTAS"
                        android:background="@drawable/chip_white"/>

                    <Space android:layout_width="6dp" android:layout_height="1dp"/>

                    <Button
                        android:id="@+id/deepScan"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="SKENUOTI"
                        android:background="@drawable/chip_white"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/discoveryLog"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginTop="8dp"
                    android:padding="10dp"
                    android:text="Diagnostikos žurnalas"
                    android:textColor="#61707C"
                    android:textSize="11sp"
                    android:background="@drawable/input_soft"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/startCast"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="START TFT"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/button_blue"/>

                    <Space android:layout_width="6dp" android:layout_height="1dp"/>

                    <Button
                        android:id="@+id/stopCast"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="STOP"
                        android:background="@drawable/chip_white"/>
                </LinearLayout>

                <Button
                    android:id="@+id/copyDiag"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="7dp"
                    android:text="KOPIJUOTI DIAGNOSTIKĄ"
                    android:background="@drawable/chip_white"/>

                <Button
                    android:id="@+id/openSpotify"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:visibility="invisible"
                    android:text="Spotify"/>

                <Button
                    android:id="@+id/mediaPermission"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:visibility="invisible"
                    android:text="Leidimas"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- FIXED BOTTOM NAV -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:background="#FFFFFF"
        android:elevation="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="◆\nPradžia"
            android:textColor="#2196F3"
            android:textSize="11sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌖\nŽemėlapis"
            android:textColor="#6F7F8D"
            android:textSize="11sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🏍\nRide"
            android:textColor="#6F7F8D"
            android:textSize="11sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♫\nMuzika"
            android:textColor="#6F7F8D"
            android:textSize="11sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⚙\nTrevoras"
            android:textColor="#6F7F8D"
            android:textSize="11sp"/>
    </LinearLayout>
</LinearLayout>
