<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#090909" android:fillViewport="true">
<LinearLayout
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="16dp">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="TREVORAS" android:textColor="#E53935" android:textStyle="bold"
        android:textSize="34sp" android:gravity="center"/>
    <TextView android:id="@+id/subtitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="ADV MULTIMEDIA • pasiruošęs"
        android:textColor="#AFAFAF" android:textSize="13sp" android:gravity="center"
        android:paddingBottom="14dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="@drawable/panel">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:text="GREITIS" android:textColor="#999999" android:textSize="12sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/speed" android:text="0" android:textColor="#FFFFFF"
                android:textSize="52sp" android:textStyle="bold"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="km/h" android:textColor="#BBBBBB" android:textSize="14sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/trip" android:text="Kelionė  0.0 km"
                android:textColor="#FFFFFF" android:textSize="17sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/maxspeed" android:text="Max  0 km/h"
                android:textColor="#FFFFFF" android:textSize="17sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/time" android:text="Laikas  00:00"
                android:textColor="#FFFFFF" android:textSize="17sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/heading" android:text="Kryptis  —"
                android:textColor="#FFFFFF" android:textSize="17sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>

    <TextView android:text="NAVIGACIJA" android:textColor="#E53935" android:textStyle="bold"
        android:textSize="16sp" android:paddingTop="16dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/panel">
        <EditText android:id="@+id/destination" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Kur važiuojam?"
            android:textColor="#FFFFFF" android:textColorHint="#888888"
            android:singleLine="true"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/googleMaps" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="Google Maps"/>
            <Button android:id="@+id/waze" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="Waze"/>
        </LinearLayout>
    </LinearLayout>

    <TextView android:text="MUZIKA" android:textColor="#E53935" android:textStyle="bold"
        android:textSize="16sp" android:paddingTop="16dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/panel">
        <TextView android:id="@+id/track" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Spotify / medija"
            android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
        <TextView android:id="@+id/artist" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="—"
            android:textColor="#AAAAAA" android:textSize="14sp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/prev" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="⏮"/>
            <Button android:id="@+id/play" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="▶ / ⏸"/>
            <Button android:id="@+id/next" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="⏭"/>
        </LinearLayout>
        <Button android:id="@+id/openSpotify" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="ATIDARYTI SPOTIFY"/>
        <Button android:id="@+id/mediaPermission" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="LEISTI MUZIKOS VALDYMĄ"/>
    </LinearLayout>

    <TextView android:text="TREVORO INFO" android:textColor="#E53935" android:textStyle="bold"
        android:textSize="16sp" android:paddingTop="16dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/panel">
        <TextView android:id="@+id/bikeInfo" android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RPM  —     Pavara  —\nVariklis  — °C     Kuras  —\nABS  —"
            android:textColor="#FFFFFF" android:textSize="18sp" android:lineSpacingExtra="7dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Šie laukai nerodys išgalvotų duomenų. Jie aktyvuosis tik radus tikrą TFT/ECU duomenų kanalą."
            android:textColor="#888888" android:textSize="12sp"/>
    </LinearLayout>

    <TextView android:text="TREVORO EKRANAS" android:textColor="#E53935" android:textStyle="bold"
        android:textSize="16sp" android:paddingTop="16dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/panel">
        <TextView android:id="@+id/castStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Projekcija: sustabdyta"
            android:textColor="#FFFFFF" android:textSize="16sp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText android:id="@+id/castIp" android:layout_width="0dp" android:layout_weight="2"
                android:layout_height="wrap_content" android:hint="TFT IP"
                android:text="192.168.43.2" android:textColor="#FFFFFF"
                android:textColorHint="#888888" android:inputType="text"/>
            <EditText android:id="@+id/castPort" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:hint="Portas"
                android:text="8888" android:textColor="#FFFFFF"
                android:textColorHint="#888888" android:inputType="number"/>
        </LinearLayout>
        <Button android:id="@+id/testTft" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="TIKRINTI TFT RYŠĮ"/>
        <Button android:id="@+id/startCast" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="EKSPERIMENTINĖ EKRANO PROJEKCIJA"
            android:background="@drawable/red_button" android:textColor="#FFFFFF"/>
        <Button android:id="@+id/stopCast" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="STABDYTI PROJEKCIJĄ"/>
    </LinearLayout>

    <TextView android:text="KELIONĖ" android:textColor="#E53935" android:textStyle="bold"
        android:textSize="16sp" android:paddingTop="16dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/startTrip" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="START"/>
        <Button android:id="@+id/resetTrip" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="RESET"/>
    </LinearLayout>
</LinearLayout>
</ScrollView>
